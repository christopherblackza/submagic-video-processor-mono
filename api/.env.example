# Server Configuration
PORT=3000
NODE_ENV=development

# OpenAI Configuration
OPEN_API_KEY=your_openai_api_key

# Submagic API Configuration
SUBMAGIC_API_KEY=your_submagic_api_key
PUBLIC_BASE_URL=http://localhost:3000
SUBMAGIC_API_URL=https://api.submagic.co

# Default Video Processing Settings
DEFAULT_LANGUAGE=en
DEFAULT_TEMPLATE_NAME=Hormozi 2
DEFAULT_MAGIC_ZOOMS=true
DEFAULT_MAGIC_BROLLS=true
DEFAULT_MAGIC_BROLLS_PERCENTAGE=60

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security & Encryption
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Test Credentials (Optional)
USERNAME=test_user
PASS=test_password
