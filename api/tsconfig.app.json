{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    
    "outDir": "../dist/out-tsc",
    "module": "commonjs",
    "types": ["node", "express", "multer"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts", "data/uploaded-media-items.ts"],
  "exclude": ["src/**/*.spec.ts", "test/**/*", "**/*.spec.ts"]
}
